# Environment for deploy/dokploy/docker-compose.anbudsklar.yml.
# Paste into the Environment tab of the Dokploy compose service and fill in every empty
# required value. Never commit the filled-in file. Every variable is described in
# docs/operations.md.

# --- Required
# https origin of the app, exactly as browsers and Eneo reach it (no trailing slash).
PUBLIC_URL=https://anbudsklar.example.se
# openssl rand -hex 32
SESSION_SECRET=
# Hex only, so it fits in DATABASE_URL: openssl rand -hex 24
POSTGRES_PASSWORD=
# user:password for the Mailpit web UI, e.g. demo:$(openssl rand -hex 12)
MAILPIT_UI_AUTH=

# --- AI engine: heuristic (no model) | eneo | openai
AI_ENGINE=heuristic
AI_MAX_RETRIES=2
AI_TIMEOUT_SECONDS=180

# Eneo test instance (AI_ENGINE=eneo). ENEO_API_KEY comes from `anbudsklar eneo provision`.
ENEO_BACKEND_URL=
ENEO_API_KEY=
ENEO_API_KEY_HEADER_NAME=X-API-Key

# OpenAI-compatible endpoint (AI_ENGINE=openai)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- MCP server. JSON list of keys Eneo may use; [] makes /mcp answer 503.
# Generate a key with: openssl rand -hex 32
MCP_ENABLED=true
MCP_API_KEYS=[]
MCP_MAX_OUTPUT_CHARS=16000
# Extra Host names for /mcp (JSON list). ["anbudsklar-app"] lets an Eneo on the same Docker
# network call http://anbudsklar-app:3001/mcp instead of the public address.
MCP_ALLOWED_HOSTS=[]

# --- Buyer persona (inköpare). Off by default here (ENVIRONMENT=production), because the buyer
# publishes what companies and Eneo's assistants read as reviewed by inköp (decision 0007).
# Turn it on only behind Traefik basic auth or an IP allowlist in front of anbudsklar-app.
#DEMO_BUYER_ENABLED=true

# --- Optional
LOG_LEVEL=INFO
MAIL_FROM=Anbudsklar <noreply@anbudsklar.local>
ORGANIZATION_NAME=Sundsvalls kommun
SHOW_ORGANIZATION=true

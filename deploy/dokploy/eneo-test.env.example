# Environment for deploy/dokploy/docker-compose.eneo-test.yml.
# Paste into the Environment tab of the Dokploy compose service and fill in every empty value.
# Never commit the filled-in file. Use hex or base64 values without quotes or spaces.

# https origin of the Eneo test instance (no trailing slash).
ENEO_PUBLIC_URL=https://eneo-test.example.se

# Image versions. The frontend image for 2.2.0-rc.5 and rc.6 is missing on ghcr.io.
ENEO_BACKEND_VERSION=2.2.0-rc.6
ENEO_FRONTEND_VERSION=2.2.0-rc.4

# --- Secrets: openssl rand -hex 32 for each, unless stated otherwise
ENEO_POSTGRES_PASSWORD=
ENEO_REDIS_PASSWORD=
ENEO_JWT_SECRET=
ENEO_API_KEY_HASH_SECRET=
ENEO_URL_SIGNING_KEY=
# Fernet key: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENEO_ENCRYPTION_KEY=

# --- First Owner user, created by eneo-db-init. Change the password after the first login.
ENEO_TENANT_NAME=Anbudsklar test
ENEO_ADMIN_NAME=Anbudsklar admin
ENEO_ADMIN_EMAIL=
ENEO_ADMIN_PASSWORD=

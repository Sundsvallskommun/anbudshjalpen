# Copy to .env and adjust. Every variable is described in docs/operations.md.
# Values here are development defaults; never commit a real .env.

ENVIRONMENT=development
# Origin the browser uses (Vite dev server in development, the app in compose).
PUBLIC_URL=http://127.0.0.1:3502
# At least 32 characters outside development: openssl rand -hex 32
SESSION_SECRET=dev-only-change-me-dev-only-change-me
COOKIE_SECURE=false
# Offer the buyer persona (inköpare). Unset: on, except with ENVIRONMENT=production.
# DEMO_BUYER_ENABLED=false

DATABASE_URL=postgresql+asyncpg://anbudsklar:anbudsklar@localhost:55432/anbudsklar
# Uploaded documents go to var/documents in the repo root unless DOCUMENTS_DIR is set.
# A relative DOCUMENTS_DIR is resolved from the working directory (backend/ for make targets).

# AI engine: heuristic (offline baseline) | eneo (Eneo assistants via API) | openai (OpenAI-compatible)
AI_ENGINE=heuristic

# Eneo test instance (AI_ENGINE=eneo). Create the key with `anbudsklar eneo provision`.
# A local Eneo on the host is http://localhost:8123 for `make dev-api`, but
# http://host.docker.internal:8123 for the compose stack (`make up`).
ENEO_BACKEND_URL=
ENEO_API_KEY=
# Same as Eneo's API_KEY_HEADER_NAME. Eneo's local dev setup uses "example".
ENEO_API_KEY_HEADER_NAME=X-API-Key

# OpenAI-compatible endpoint (AI_ENGINE=openai)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Keys Eneo uses to call our MCP server (JSON list). Empty = MCP answers 503.
MCP_API_KEYS=[]
# Extra host names /mcp accepts besides PUBLIC_URL's (JSON list), e.g. the Dokploy service name.
# MCP_ALLOWED_HOSTS=["anbudsklar-app"]

SMTP_HOST=localhost
SMTP_PORT=1025
SCHEDULER_ENABLED=true

ORGANIZATION_NAME=Sundsvalls kommun

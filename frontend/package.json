{
  "name": "anbudsklar-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3502 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3502 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "theme:build": "npm run astryx -- theme build src/theme/eneo.theme.ts -o src/theme/built/eneo.css",
    "theme:check": "npm run astryx -- theme build src/theme/eneo.theme.ts -o src/theme/built/eneo.css --check",
    "icons": "node scripts/icons.mjs",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "gate": "playwright test"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.3",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-query": "5.104.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.3",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  }
}
